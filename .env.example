# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# No se usa en el cliente; la app accede a Supabase solo con service role en servidor.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo servidor (nunca exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Supabase → Project Settings → Database → Connection string
# Usa la URI del **Session pooler** (host aws-0-*.pooler.supabase.com)
# NO uses db.*.supabase.co (conexión directa, suele fallar desde local)
# Si la contraseña tiene símbolos, codifícalos: * → %2A, @ → %40
DATABASE_URL=postgresql://postgres.tu-ref:tu-password@aws-0-tu-region.pooler.supabase.com:5432/postgres

# Secreto para sesiones (mínimo 32 caracteres)
AUTH_SECRET=genera-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres

# Recuperación de contraseña — opción recomendada: Brevo (gratis, sin dominio, funciona en Vercel)
# 1. Crea cuenta en https://www.brevo.com
# 2. Senders → agrega tu Gmail personal → verifica con el enlace que te envían
# 3. SMTP & API → API Keys → crea una clave
# 4. En Vercel, pon APP_URL con tu URL .vercel.app
BREVO_API_KEY=xkeysib-xxxxxxxx
EMAIL_FROM=Pórtico APP <tu-correo@gmail.com>
APP_URL=https://tu-proyecto.vercel.app

# Alternativa local: Gmail SMTP (requiere verificación en 2 pasos + contraseña de aplicación)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
